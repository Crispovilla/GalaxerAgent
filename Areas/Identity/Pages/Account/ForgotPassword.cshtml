@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<div class="passwordBox animated fadeInDown pt-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 col-xl-4">
            <div class="ibox-content rounded-4 shadow-lg p-4 p-sm-5">

                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="ti ti-lock-question text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h2 class="fw-bold">¿Problemas para entrar?</h2>
                    <p class=" small">
                        Ingresa tu correo institucional y te enviaremos un enlace para recuperar el acceso a tu cuenta.
                    </p>
                </div>

                <form method="post">
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="form-group mb-4">
                        <label asp-for="Input.Email" class="form-label small fw-bold text-uppercase">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="ti ti-mail"></i>
                            </span>
                            <input asp-for="Input.Email" class="form-control border-start-0 ps-0" placeholder="usuario@derecho.uchile.cl" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm text-uppercase mb-3">
                        Enviar enlace de recuperación
                    </button>

                    <div class="text-center">
                        <a asp-page="./Login" class="small text-decoration-none fw-semibold">
                            <i class="ti ti-arrow-narrow-left me-1"></i> Volver al inicio de sesión
                        </a>
                    </div>
                </form>

                <div class="mt-4 text-center border-top pt-3">
                    <p class="extra-small mb-0">
                        Si no recibes el correo en 5 minutos, revisa tu carpeta de Spam.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}