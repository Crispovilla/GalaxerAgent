@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="loginColumns animated fadeInDown pt-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 col-xl-4">
            <div class="ibox-content rounded-4 shadow-lg p-4 p-sm-5">

                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="ti ti-shield-lock text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h2 class="fw-bold">Nueva Contraseña</h2>
                    <p class="small">Crea una clave segura para tu cuenta institucional.</p>
                </div>

                <form method="post">
                    <input type="hidden" asp-for="Input.Code" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    @* Email (Readonly para seguridad y contexto) *@
                    <div class="form-group mb-3">
                        <label asp-for="Input.Email" class="form-label small fw-bold text-uppercase">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="ti ti-mail"></i>
                            </span>
                            <input asp-for="Input.Email" class="form-control border-start-0 ps-0" readonly />
                        </div>
                    </div>

                    @* Password *@
                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label small fw-bold text-uppercase">Nueva Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="ti ti-lock"></i>
                            </span>
                            <input asp-for="Input.Password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    @* Confirm Password *@
                    <div class="form-group mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label small fw-bold text-uppercase">Confirmar Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="ti ti-lock-check"></i>
                            </span>
                            <input asp-for="Input.ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm text-uppercase">
                        Actualizar Contraseña <i class="ti ti-refresh ms-1"></i>
                    </button>
                </form>

                <div class="mt-4 text-center">
                    <p class="small mb-0">© @DateTime.Now.Year Facultad de Derecho - Universidad de Chile</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}