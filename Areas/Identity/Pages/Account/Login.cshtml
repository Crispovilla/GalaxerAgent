@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    // Si tienes un layout base limpio, úsalo. Si no, comenta la siguiente línea.
    // Layout = "~/Pages/Shared/_BaseLayout.cshtml";
}

<div class="loginColumns animated fadeInDown pt-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 col-xl-4">
            <div class="ibox-content rounded-4 shadow-lg p-4 p-sm-5">

                <div class="text-center mb-4">
                    <h2 class="fw-bold">Iniciar Sesión</h2>
                    <p class="small">Usa tu cuenta institucional para continuar.</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Email" class="form-label small fw-bold text-uppercase">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="ti ti-mail"></i>
                            </span>
                            <input asp-for="Input.Email" class="form-control border-start-0 ps-0" placeholder="usuario@derecho.uchile.cl" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label small fw-bold text-uppercase">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="ti ti-lock"></i>
                            </span>
                            <input asp-for="Input.Password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label small" asp-for="Input.RememberMe">
                                Recordarme
                            </label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none fw-semibold">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm text-uppercase">
                        Ingresar <i class="ti ti-chevron-right ms-1"></i>
                    </button>
                </form>

                <div class="mt-4 text-center">
                    <p class="small mb-0">© @DateTime.Now.Year Facultad de Derecho - Universidad de Chile</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}