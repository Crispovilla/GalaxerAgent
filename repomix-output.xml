// 
// Variables
//

// Prefix for :root CSS variables

$prefix:                      ins-;

// Theme mode (If you want to use only one theme, set that theme to true and set all other themes to false.)
$theme-classic:          true; // Default Theme
$theme-saas:             true;
$theme-modern:           true;
$theme-minimal:          true;
$theme-flat:             true;
$theme-material:         true;
$theme-galaxy:           true;

// Color system

// scss-docs-start gray-color-variables
$white:    #fff;
$gray-100: #f6f7fb;
$gray-200: #eef2f7;
$gray-300: #e7e9eb;
$gray-400: #ced4da;
$gray-500: #a1a9b1;
