<file path="Program.cs">
using Base_MVC_Core9.Data;
using Base_MVC_Core9.Entities;
using Base_MVC_Core9.Interfaces;
using Base_MVC_Core9.Services;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.DataProtection;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Identity.UI.Services;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Authorization;
using Microsoft.EntityFrameworkCore;

var builder = WebApplication.CreateBuilder(args);

// ── 1. CONFIGURACIÓN DE BASES DE DATOS ──────────────────────
// Contexto para Identity
builder.Services.AddDbContext<ApplicationDbContext>(options =>
{
    options.UseSqlServer(builder.Configuration.GetConnectionString("LoginConnection"));
    options.ConfigureWarnings(w => w.Ignore(Microsoft.EntityFrameworkCore.Diagnostics.RelationalEventId.PendingModelChangesWarning));
});

// Contexto para Negocio (Persona)
builder.Services.AddDbContext<PersonaDbContext>(options =>
{
    options.UseSqlServer(builder.Configuration.GetConnectionString("PersonaConnection")
        ?? builder.Configuration.GetConnectionString("LoginConnection")); // Fallback al default si no existe
    options.ConfigureWarnings(w => w.Ignore(Microsoft.EntityFrameworkCore.Diagnostics.RelationalEventId.PendingModelChangesWarning));
});

builder.Services.AddDbContext<SistemaDbContext>(options =>
    options.UseSqlServer(builder.Configuration.GetConnectionString("SistemaConnection")));

builder.Services.AddScoped<IMenuNavegacionService, MenuNavegacionService>();

// ── 2. IDENTITY (Registro único y limpio) ──────────────────
builder.Services.AddIdentity<ApplicationUser, IdentityRole>(options =>
{
    options.SignIn.RequireConfirmedAccount = true;
    options.Password.RequireDigit = true;
    options.Password.RequiredLength = 8;
    options.Password.RequireUppercase = true;
    options.Password.RequireNonAlphanumeric = false;
    options.User.RequireUniqueEmail = true;
})
.AddEntityFrameworkStores<ApplicationDbContext>()
.AddDefaultTokenProviders()
.AddDefaultUI();

// ── 3. SERVICIOS ADICIONALES ───────────────────────────────
builder.Services.AddTransient<IEmailSenderCustom, EmailSender>();
builder.Services.AddHttpContextAccessor();

builder.Services.AddScoped<IUserAppService, UserAppService>();
builder.Services.AddScoped<Base_MVC_Core9.Interfaces.IPersonaRepository, Base_MVC_Core9.Persistence.Repositories.PersonaRepository>();
// ── 4. SEGURIDAD, COOKIES Y TOKENS ─────────────────────────
builder.Services.Configure<DataProtectionTokenProviderOptions>(options =>
{
    options.TokenLifespan = TimeSpan.FromDays(30);
});

builder.Services.ConfigureApplicationCookie(options =>
{
    options.Cookie.Name = "BaseMVC_Identity";
    options.LoginPath = "/Identity/Account/Login";
    options.LogoutPath = "/Identity/Account/Logout";
    options.AccessDeniedPath = "/Identity/Account/AccessDenied";
    options.ExpireTimeSpan = TimeSpan.FromHours(24);
    options.SlidingExpiration = true;
    options.Cookie.HttpOnly = true;
});

builder.Services.AddDataProtection()
    .PersistKeysToFileSystem(new DirectoryInfo(@"C:\temp\Keys-BaseMVC"));

// ── 5. MVC CON FILTROS GLOBALES ────────────────────────────
builder.Services.AddControllersWithViews(options =>
{
    // Bloqueo global: Autenticación requerida por defecto
    var policy = new AuthorizationPolicyBuilder()
        .RequireAuthenticatedUser()
        .Build();
    options.Filters.Add(new AuthorizeFilter(policy));

    // Validación automática de Antiforgery
    options.Filters.Add(new AutoValidateAntiforgeryTokenAttribute());
});

// ── 6. RAZOR PAGES (Para Identity) ─────────────────────────
builder.Services.AddRazorPages(options =>
{
    options.Conventions.AllowAnonymousToAreaPage("Identity", "/Account/Login");
    options.Conventions.AllowAnonymousToAreaPage("Identity", "/Account/ForgotPassword");
    options.Conventions.AllowAnonymousToAreaPage("Identity", "/Account/ResetPassword");
    options.Conventions.AllowAnonymousToAreaPage("Identity", "/Account/ResetPasswordConfirmation");
    options.Conventions.AllowAnonymousToAreaPage("Identity", "/Account/ConfirmEmail");
});

var app = builder.Build();

// ── 7. INICIALIZACIÓN DE DATOS (Seeding) ───────────────────
using (var scope = app.Services.CreateScope())
{
    var services = scope.ServiceProvider;
    try
    {
        var identityContext = services.GetRequiredService<ApplicationDbContext>();
        await identityContext.Database.MigrateAsync();

        // Si usas migraciones en el contexto de personas, descomenta:
        // var personaContext = services.GetRequiredService<PersonaDbContext>();
        // await personaContext.Database.MigrateAsync();

        // Seed de Roles y Admin (Asegúrate de tener esta clase)
        // await DbInitializer.SeedRolesAndAdminAsync(services);
    }
    catch (Exception ex)
    {
        var logger = services.GetRequiredService<ILogger<Program>>();
        logger.LogError(ex, "Error crítico en el arranque de la BD.");
    }
}

// ── 8. PIPELINE DE MIDDLEWARE ──────────────────────────────
if (app.Environment.IsDevelopment())
{
    app.UseDeveloperExceptionPage();
}
else
{
    app.UseExceptionHandler("/Home/Error");
    app.UseHsts();
}

app.UseStatusCodePagesWithReExecute("/Home/Error", "?statusCode={0}");
app.UseHttpsRedirection();
app.UseStaticFiles();
app.UseRouting();

app.UseAuthentication();
app.UseAuthorization();

// ── 9. RUTAS ───────────────────────────────────────────────
app.MapRazorPages();
app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Home}/{action=Index}/{id?}");

app.Run();
</file>

<file path="azure-pipelines.yml">
trigger:
- main

variables:
  buildConfiguration: 'Release'

stages:
# ==========================================
# STAGE 1: COMPILACIÓN (Se ejecuta en la nube)
# ==========================================
- stage: Build
  displayName: 'Compilar Aplicación'
  jobs:
  - job: BuildJob
    pool:
      vmImage: 'windows-latest' # Máquina virtual de Microsoft
    steps:
    - task: UseDotNet@2
      displayName: 'Instalar .NET Core SDK 9.x'
      inputs:
        packageType: 'sdk'
        version: '9.x'

    - task: DotNetCoreCLI@2
      displayName: 'Restaurar Paquetes (Dotnet Restore)'
      inputs:
        command: 'restore'
        projects: '**/*.csproj'

    - task: DotNetCoreCLI@2
      displayName: 'Compilar Proyecto (Dotnet Build)'
      inputs:
        command: 'build'
        projects: '**/*.csproj'
        arguments: '--configuration $(buildConfiguration)'

    - task: DotNetCoreCLI@2
      displayName: 'Publicar Sitio Web (Dotnet Publish)'
      inputs:
        command: 'publish'
        publishWebProjects: true
        arguments: '--configuration $(buildConfiguration) --output $(build.artifactStagingDirectory)'
        zipAfterPublish: false # 👈 Cambiado a false para copiar carpetas directas en el IIS

    - task: PublishBuildArtifacts@1
      displayName: 'Publicar Artefacto Base-MVC-Core9'
      inputs:
        PathtoPublish: '$(build.artifactStagingDirectory)'
        ArtifactName: 'Base-MVC-Core9'
        publishLocation: 'Container'

# ==========================================
# STAGE 2: DESPLIEGUE EN QA (Automático al terminar Build)
# ==========================================
- stage: DeployQA
  displayName: 'Desplegar en Entorno QA'
  dependsOn: Build
  condition: succeeded()
  jobs:
  - deployment: DeployJobQA
    displayName: 'Desplegar en IIS de QA'
    pool:
      name: 'Servidor-Oficina' # 👈 El nombre del agente en tu servidor local
      demands: Agent.Name -equals AGENTE-QA # 👈 Reemplaza por el nombre real de tu agente de QA
    environment: 'Entorno-QA'  # 👈 Vinculado a tu entorno de Azure DevOps
    strategy:
      runOnce:
        deploy:
          steps:
          - task: DownloadBuildArtifacts@0
            displayName: 'Descargar Artefacto Base-MVC-Core9'
            inputs:
              buildType: 'current'
              downloadType: 'single'
              artifactName: 'Base-MVC-Core9'
              downloadPath: '$(System.ArtifactsDirectory)'

          - task: PowerShell@2
            displayName: 'Actualizar IIS Local en QA'
            inputs:
              targetType: 'inline'
              script: |
                Import-Module WebAdministration
                $siteName = "Base.NET-CORE-QA" # 👈 Cambia por el nombre de tu sitio en el IIS de QA
                $targetPath = "C:\inetpub\wwwroot\Base.NET-CORE-QA" # 👈 Ruta física de QA
                
                Stop-WebAppPool -Name $siteName -ErrorAction SilentlyContinue
                Remove-Item -Path "$targetPath\*" -Recurse -Force
                # Nota: Azure añade el subdirectorio de publicación de .NET dentro del artefacto
                Copy-Item -Path "$(System.ArtifactsDirectory)\Base-MVC-Core9\s\*" -Destination $targetPath -Recurse -Force
                Start-WebAppPool -Name $siteName

# ==========================================
# STAGE 3: DESPLIEGUE EN PRODUCCIÓN (Espera tu Aprobación Manual)
# ==========================================
- stage: DeployProd
  displayName: 'Desplegar en Entorno Producción'
  dependsOn: DeployQA
  condition: succeeded()
  jobs:
  - deployment: DeployJobProd
    displayName: 'Desplegar en IIS de Producción'
    pool:
      name: 'Servidor-Oficina'
      demands: Agent.Name -equals AGENTE-PROD # 👈 Reemplaza por el nombre real de tu agente de Prod
    environment: 'Entorno-Produccion' # 👈 Aquí configuras el "Approval Check" en la web
    strategy:
      runOnce:
        deploy:
          steps:
          - task: DownloadBuildArtifacts@0
            displayName: 'Descargar Artefacto Base-MVC-Core9'
            inputs:
              buildType: 'current'
              downloadType: 'single'
              artifactName: 'Base-MVC-Core9'
              downloadPath: '$(System.ArtifactsDirectory)'

          - task: PowerShell@2
            displayName: 'Actualizar IIS Local en Producción'
            inputs:
              targetType: 'inline'
              script: |
                Import-Module WebAdministration
                $siteName = "Base.NET-CORE-PROD" # 👈 Nombre de tu sitio en el IIS Productivo
                $targetPath = "C:\inetpub\wwwroot\Base.NET-CORE-PROD" # 👈 Ruta física de Producción
                
                Stop-WebAppPool -Name $siteName -ErrorAction SilentlyContinue
                Remove-Item -Path "$targetPath\*" -Recurse -Force
                Copy-Item -Path "$(System.ArtifactsDirectory)\Base-MVC-Core9\s\*" -Destination $targetPath -Recurse -Force
                Start-WebAppPool -Name $siteName
</file>

