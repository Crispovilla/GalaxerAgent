@{
    ViewData["Title"] = "Halcón Milenario · Agente";
    ViewData["HideNav"] = true;
}

@section styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Rajdhani:wght@400;500;600&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        #canvas-container {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            display: block;
            z-index: 1;
            background: radial-gradient(ellipse at center, #071026 0%, #03060f 70%);
        }

        /* ── Efectos HUD de fondo ─────────────────────────── */
        #hud-fx {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 2;
            overflow: hidden;
        }

        #hud-fx .vignette {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center, transparent 42%, rgba(2, 6, 18, 0.72) 100%);
        }

        #hud-fx .scan {
            position: absolute;
            left: 0;
            right: 0;
            height: 160px;
            background: linear-gradient(to bottom, transparent, rgba(0, 255, 204, 0.07) 50%, transparent);
            animation: hudScan 9s linear infinite;
        }

        #hud-fx .frame {
            position: absolute;
            inset: 14px;
            border: 1px solid rgba(0, 255, 204, 0.12);
        }

        #hud-fx .frame::before,
        #hud-fx .frame::after {
            content: "";
            position: absolute;
            width: 26px;
            height: 26px;
            border: solid rgba(0, 255, 204, 0.55);
        }

        #hud-fx .frame::before {
            top: -1px;
            left: -1px;
            border-width: 2px 0 0 2px;
        }

        #hud-fx .frame::after {
            bottom: -1px;
            right: -1px;
            border-width: 0 2px 2px 0;
        }

        /* Efecto hiperespacio (se activa mientras la nave viaja) */
        #hud-fx .streaks {
            position: absolute;
            inset: -50%;
            background: repeating-conic-gradient(from 0deg at 50% 50%, transparent 0deg 5deg, rgba(170, 220, 255, 0.12) 5deg 5.5deg);
            -webkit-mask-image: radial-gradient(circle, transparent 16%, black 70%);
            mask-image: radial-gradient(circle, transparent 16%, black 70%);
            opacity: 0;
            transition: opacity 0.7s ease;
        }

        #hud-fx.warp .streaks {
            opacity: 1;
            animation: warpSpin 16s linear infinite;
        }

        #hud-fx.warp .scan {
            animation-duration: 4.5s;
        }

        @@keyframes warpSpin {
            to { transform: rotate(360deg); }
        }

        @@keyframes hudScan {
            0% { top: -18%; opacity: 0; }
            12% { opacity: 1; }
            88% { opacity: 1; }
            100% { top: 118%; opacity: 0; }
        }

        @@keyframes hudPulse {
            50% { opacity: 0.3; }
        }

        @@keyframes hudSheen {
            0% { left: -80%; }
            55%, 100% { left: 135%; }
        }

        @@keyframes hudBlink {
            50% { opacity: 0.2; }
        }

        /* ── Parabrisas del cockpit (esquinas superiores) ── */
        #hud-fx .strut {
            position: absolute;
            top: 0;
            height: 48%;
            width: 30%;
            background: linear-gradient(165deg, rgba(3, 8, 17, 0.92), rgba(3, 8, 17, 0.55) 55%, rgba(3, 8, 17, 0));
            pointer-events: none;
        }

        #hud-fx .strut.l { left: 0; clip-path: polygon(0 0, 100% 0, 0 100%); }
        #hud-fx .strut.r { right: 0; clip-path: polygon(0 0, 100% 0, 100% 100%); }

        /* ── Computadora de navegación (arriba derecha) ─── */
        #hud-waypoint {
            position: fixed;
            top: 26px;
            right: 26px;
            z-index: 10;
            min-width: 214px;
            box-sizing: border-box;
            padding: 12px 14px;
            font-family: 'Share Tech Mono', monospace;
            color: #d7e7ff;
            background: linear-gradient(160deg, rgba(8, 14, 28, 0.88), rgba(4, 8, 18, 0.92));
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 232, 31, 0.35);
            border-radius: 5px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 25px rgba(255, 232, 31, 0.08);
            opacity: 0;
            transform: translateY(-14px);
            transition: opacity 0.4s ease, transform 0.4s ease;
            pointer-events: none;
        }

        #hud-waypoint.show { opacity: 1; transform: translateY(0); }

        #hud-waypoint .wp-k {
            font-size: 0.56rem;
            letter-spacing: 2.5px;
            color: #b99b3a;
            text-transform: uppercase;
        }

        #hud-waypoint .wp-k::before { content: "\25B8 "; color: #ffe81f; }

        #hud-waypoint #wp-name {
            margin-top: 5px;
            font-size: 0.86rem;
            color: #ffe81f;
            text-shadow: 0 0 10px rgba(255, 232, 31, 0.5);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 250px;
        }

        #hud-waypoint .wp-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 7px;
            font-size: 0.72rem;
            color: #9fd8ff;
        }

        #hud-waypoint #wp-arrow {
            width: 18px;
            height: 18px;
            transition: transform 0.2s linear;
        }

        #hud-waypoint #wp-arrow polygon {
            fill: #00ffcc;
            filter: drop-shadow(0 0 4px #00ffcc);
        }

        #hud-waypoint #wp-dist { color: #00ffcc; }

        /* ── FX de lanzamiento ─────────────────────────── */
        #launch-fx {
            position: fixed;
            inset: 0;
            z-index: 30;
            pointer-events: none;
            opacity: 0;
            background: radial-gradient(circle at 50% 62%, rgba(210, 250, 255, 0.95), rgba(0, 190, 255, 0.4) 32%, transparent 72%);
        }

        body.launching #launch-fx { animation: launchFlash 1.35s ease-out forwards; }

        @@keyframes launchFlash {
            0% { opacity: 0; transform: scale(0.55); }
            12% { opacity: 1; }
            100% { opacity: 0; transform: scale(1.7); }
        }

        /* ── Panel inferior: dashboard del cockpit ──────── */
        #dash {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            height: 106px;
            z-index: 4;
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 26px;
            padding: 14px 30px 8px;
            background: linear-gradient(to top, rgba(2, 6, 14, 0.95), rgba(2, 6, 14, 0.78) 55%, rgba(2, 6, 14, 0));
            clip-path: polygon(0 26px, 7% 4px, 93% 4px, 100% 26px, 100% 100%, 0 100%);
            font-family: 'Share Tech Mono', monospace;
            color: #9fd8ff;
        }

        #dash .dash-mod {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        #dash .mod-k {
            font-size: 0.52rem;
            letter-spacing: 2px;
            color: #5f7a99;
            text-transform: uppercase;
        }

        #dash #radar {
            width: 78px;
            height: 78px;
            display: block;
        }

        #dash #speedo {
            width: 132px;
            display: block;
        }

        #dash .pwr-bars {
            display: flex;
            gap: 5px;
        }

        #dash .pwr-bars i {
            width: 14px;
            height: 26px;
            border-radius: 2px;
            border: 1px solid rgba(255, 179, 71, 0.4);
            background: rgba(255, 179, 71, 0.08);
            transition: background 0.25s, box-shadow 0.25s;
        }

        #dash .pwr-bars i.on {
            background: #ffb347;
            box-shadow: 0 0 10px rgba(255, 179, 71, 0.7);
        }

        #dash .nav-mod {
            margin-left: auto;
            text-align: right;
        }

        #dash .nav-line {
            font-size: 0.74rem;
            color: #72f2eb;
            letter-spacing: 1px;
            margin-top: 3px;
        }

        #dash .nav-line b {
            color: #ffe81f;
            font-weight: normal;
        }

        @@media (max-width: 760px) {
            #dash .radar-mod, #dash .nav-mod { display: none; }
        }

        /* ── Panel principal ──────────────────────────────── */
        #ui-panel {
            position: absolute;
            top: 26px;
            left: 26px;
            width: 384px;
            box-sizing: border-box;
            padding: 22px 22px 18px;
            z-index: 10;
            color: #d7e7ff;
            font-family: 'Rajdhani', 'Segoe UI', sans-serif;
            background: linear-gradient(160deg, rgba(8, 14, 28, 0.9), rgba(4, 8, 18, 0.94));
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(0, 255, 204, 0.28);
            border-radius: 5px;
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.55), 0 0 35px rgba(0, 255, 204, 0.08), inset 0 0 60px rgba(0, 255, 204, 0.035);
        }

        #ui-panel::before,
        #ui-panel::after,
        #ui-panel .brackets::before,
        #ui-panel .brackets::after {
            content: "";
            position: absolute;
            width: 22px;
            height: 22px;
            border: solid #00ffcc;
            pointer-events: none;
        }

        #ui-panel::before { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
        #ui-panel::after { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }
        #ui-panel .brackets::before { top: -1px; right: -1px; border-width: 2px 2px 0 0; border-color: rgba(0, 136, 255, 0.9); }
        #ui-panel .brackets::after { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; border-color: rgba(0, 136, 255, 0.9); }

        /* ── Encabezado ───────────────────────────────────── */
        #ui-panel .panel-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            padding-bottom: 14px;
            margin-bottom: 16px;
            border-bottom: 1px solid rgba(0, 255, 204, 0.16);
            position: relative;
        }

        #ui-panel .panel-head::after {
            content: "";
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 72px;
            height: 1px;
            background: #00ffcc;
            box-shadow: 0 0 10px #00ffcc;
        }

        #ui-panel h3 {
            margin: 0;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            background: linear-gradient(90deg, #ffe81f, #ffb347 42%, #00ffcc 82%, #0088ff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 8px rgba(255, 200, 40, 0.35));
        }

        #ui-panel .head-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        #ui-panel .ship-icon {
            width: 34px;
            height: 34px;
            color: #00ffcc;
            filter: drop-shadow(0 0 6px rgba(0, 255, 204, 0.6));
            flex-shrink: 0;
        }

        #ui-panel .subtitle {
            margin-top: 5px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.62rem;
            letter-spacing: 3px;
            color: #5f7a99;
            text-transform: uppercase;
        }

        #ui-panel .status {
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.62rem;
            letter-spacing: 1.5px;
            color: #8affe8;
            white-space: nowrap;
            padding-top: 4px;
        }

        #ui-panel .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ffcc00;
            color: #ffcc00;
            box-shadow: 0 0 9px currentColor;
            animation: hudPulse 1.6s ease-in-out infinite;
        }

        #ui-panel .dot.online { background: #00ff9d; color: #00ff9d; }
        #ui-panel .dot.linking { background: #ffcc00; color: #ffcc00; }
        #ui-panel .dot.offline { background: #ff3b6b; color: #ff3b6b; }

        /* ── Campos ───────────────────────────────────────── */
        #ui-panel .field { margin-bottom: 14px; }

        #ui-panel label {
            display: block;
            margin-bottom: 6px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.66rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #6fe3ff;
        }

        #ui-panel label::before {
            content: "\25B8 ";
            color: #00ffcc;
        }

        #ui-panel input,
        #ui-panel textarea {
            width: 100%;
            box-sizing: border-box;
            background: rgba(0, 255, 255, 0.04);
            border: 1px solid rgba(120, 180, 255, 0.18);
            border-left: 2px solid rgba(0, 255, 204, 0.55);
            border-radius: 3px;
            color: #e6f6ff;
            padding: 10px 12px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.78rem;
            outline: none;
            transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
        }

        #ui-panel input:focus,
        #ui-panel textarea:focus {
            border-color: rgba(0, 255, 204, 0.7);
            background: rgba(0, 255, 204, 0.07);
            box-shadow: 0 0 0 1px rgba(0, 255, 204, 0.25), 0 0 18px rgba(0, 255, 204, 0.18);
        }

        #ui-panel textarea { resize: vertical; min-height: 64px; }

        /* ── Fila de ruta con explorador ─────────────────── */
        #ui-panel .path-row { display: flex; gap: 0; align-items: stretch; }

        #ui-panel .path-row input {
            flex: 1 1 auto;
            min-width: 0;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        #ui-panel #btnBrowse {
            flex: 0 0 auto;
            padding: 0 15px;
            border: 1px solid rgba(120, 180, 255, 0.18);
            border-left: none;
            border-right: 2px solid rgba(0, 255, 204, 0.55);
            border-radius: 0 3px 3px 0;
            background: rgba(0, 255, 204, 0.07);
            color: #00ffcc;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.2s, box-shadow 0.2s;
        }

        #ui-panel #btnBrowse:hover {
            background: rgba(0, 255, 204, 0.18);
            box-shadow: 0 0 14px rgba(0, 255, 204, 0.3);
        }

        /* ── Modal explorador de rutas ───────────────────── */
        #path-explorer {
            position: fixed;
            inset: 0;
            z-index: 60;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(2, 6, 18, 0.35);
        }

        #path-explorer.open { display: flex; }

        #path-explorer .pe-box {
            width: min(660px, 94vw);
            max-height: 78vh;
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(0, 255, 204, 0.35);
            border-radius: 6px;
            background: linear-gradient(180deg, rgba(6, 18, 34, 0.98), rgba(3, 8, 16, 0.98));
            box-shadow: 0 0 44px rgba(0, 255, 204, 0.18);
            font-family: 'Share Tech Mono', monospace;
        }

        #path-explorer .pe-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px;
            border-bottom: 1px solid rgba(0, 255, 204, 0.2);
            color: #00ffcc;
            font-size: 0.74rem;
            letter-spacing: 2.5px;
            text-transform: uppercase;
        }

        #path-explorer .pe-head button {
            border: none;
            background: none;
            color: #6fe3ff;
            font-size: 1.15rem;
            line-height: 1;
            cursor: pointer;
            padding: 0 4px;
        }

        #path-explorer .pe-head button:hover { color: #ff3b6b; }

        #path-explorer .pe-hint {
            color: #6fe3ff;
            font-size: 0.62rem;
            letter-spacing: 1px;
            text-transform: none;
            opacity: 0.75;
            margin-left: auto;
            margin-right: 12px;
        }

        @@media (max-width: 720px) {
            #path-explorer .pe-hint { display: none; }
        }

        #path-explorer .pe-crumb {
            padding: 9px 14px;
            border-bottom: 1px solid rgba(120, 180, 255, 0.14);
            background: rgba(0, 255, 255, 0.04);
            color: #8affe8;
            font-size: 0.74rem;
            word-break: break-all;
            min-height: 20px;
        }

        #path-explorer .pe-list {
            flex: 1 1 auto;
            overflow-y: auto;
            padding: 6px;
            min-height: 180px;
            max-height: 46vh;
        }

        #path-explorer .pe-item {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            padding: 9px 10px;
            border: 1px solid transparent;
            border-radius: 3px;
            background: none;
            color: #dff4ff;
            font-family: inherit;
            font-size: 0.78rem;
            text-align: left;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s;
        }

        #path-explorer .pe-item:hover {
            background: rgba(0, 255, 204, 0.09);
            border-color: rgba(0, 255, 204, 0.35);
        }

        #path-explorer .pe-item svg { flex: 0 0 auto; color: #ffcc00; }

        #path-explorer .pe-item.pe-up { color: #6fe3ff; }
        #path-explorer .pe-item.pe-up svg { color: #6fe3ff; }

        #path-explorer .pe-empty,
        #path-explorer .pe-msg {
            padding: 14px 10px;
            color: #7f93a8;
            font-size: 0.74rem;
            text-align: center;
        }

        #path-explorer .pe-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 11px 14px;
            border-top: 1px solid rgba(0, 255, 204, 0.2);
        }

        #path-explorer .pe-foot #pe-msg {
            color: #ff8fa3;
            font-size: 0.7rem;
            word-break: break-all;
        }

        #path-explorer .pe-actions { display: flex; gap: 8px; flex-shrink: 0; }

        #path-explorer .pe-actions button {
            padding: 9px 14px;
            border-radius: 3px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: box-shadow 0.2s, background 0.2s;
        }

        #path-explorer #pe-cancel {
            border: 1px solid rgba(120, 180, 255, 0.3);
            background: transparent;
            color: #6fe3ff;
        }

        #path-explorer #pe-cancel:hover { background: rgba(120, 180, 255, 0.12); }

        #path-explorer #pe-select {
            border: none;
            background: linear-gradient(135deg, #00ffcc, #00a2ff);
            color: #021018;
            font-weight: 700;
        }

        #path-explorer #pe-select:hover { box-shadow: 0 0 18px rgba(0, 255, 204, 0.5); }

        #path-explorer #pe-select:disabled {
            opacity: 0.35;
            cursor: not-allowed;
            box-shadow: none;
        }

        /* ── Botón ────────────────────────────────────────── */
        #ui-panel #btnStart {
            position: relative;
            overflow: hidden;
            width: 100%;
            margin-top: 2px;
            padding: 13px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #021018;
            background: linear-gradient(135deg, #00ffcc, #00a2ff);
            box-shadow: 0 0 18px rgba(0, 255, 204, 0.35), inset 0 0 12px rgba(255, 255, 255, 0.25);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        #ui-panel #btnStart:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 32px rgba(0, 255, 204, 0.6), 0 8px 22px rgba(0, 0, 0, 0.45);
        }

        #ui-panel #btnStart:active { transform: translateY(0) scale(0.985); }

        #ui-panel #btnStart::after {
            content: "";
            position: absolute;
            top: 0;
            left: -80%;
            width: 45%;
            height: 100%;
            background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.55), transparent);
            transform: skewX(-20deg);
            animation: hudSheen 3.4s ease-in-out infinite;
        }

        /* ── Barra de misión ─────────────────────────────── */
        #ui-panel .mission-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 12px;
            padding: 9px 11px;
            border: 1px solid rgba(0, 136, 255, 0.35);
            border-left: 2px solid #0088ff;
            border-radius: 3px;
            background: rgba(0, 60, 120, 0.16);
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 1px;
            min-height: 20px;
        }

        #ui-panel .mission-bar .mission-label {
            color: #0088ff;
            text-transform: uppercase;
            letter-spacing: 2px;
            flex-shrink: 0;
        }

        #ui-panel .mission-bar .mission-label::before {
            content: "\25C6 ";
            color: #00ffcc;
        }

        #ui-panel #mission-status {
            color: #9fd8ff;
            word-break: break-word;
        }

        #ui-panel #mission-status.working { color: #00ffcc; text-shadow: 0 0 8px rgba(0, 255, 204, 0.5); }
        #ui-panel #mission-status.done { color: #3dff9e; text-shadow: 0 0 8px rgba(61, 255, 158, 0.6); }
        #ui-panel #mission-status.error { color: #ff4d6d; text-shadow: 0 0 8px rgba(255, 77, 109, 0.6); }

        #ui-panel .mission-bar.is-working {
            border-color: rgba(0, 255, 204, 0.5);
            background-image: repeating-linear-gradient(115deg, rgba(0, 255, 204, 0.10) 0 10px, transparent 10px 20px);
            animation: missionSlide 1s linear infinite;
        }

        @@keyframes missionSlide {
            to { background-position: -20px 0; }
        }

        /* ── Telemetría del halcón ────────────────────────── */
        #ui-panel .telemetry {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin-top: 12px;
        }

        #ui-panel .tel {
            border: 1px solid rgba(255, 179, 71, 0.25);
            background: rgba(60, 34, 0, 0.18);
            border-radius: 3px;
            padding: 6px 4px;
            text-align: center;
            font-family: 'Share Tech Mono', monospace;
            min-width: 0;
        }

        #ui-panel .tel .tel-k {
            display: block;
            font-size: 0.5rem;
            letter-spacing: 1.5px;
            color: #b98a4a;
            text-transform: uppercase;
        }

        #ui-panel .tel .tel-v {
            display: block;
            margin-top: 3px;
            font-size: 0.72rem;
            color: #ffb347;
            text-shadow: 0 0 8px rgba(255, 179, 71, 0.45);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #ui-panel .tel .tel-v.on {
            color: #3dff9e;
            text-shadow: 0 0 8px rgba(61, 255, 158, 0.6);
        }

        /* ── Log ──────────────────────────────────────────── */
        #ui-panel .log-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 17px;
            margin-bottom: 6px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.62rem;
            letter-spacing: 2.5px;
            color: #5f7a99;
            text-transform: uppercase;
        }

        #ui-panel .log-head .live::before {
            content: "\25CF";
            color: #ff3b6b;
            margin-right: 6px;
            animation: hudBlink 1.3s ease-in-out infinite;
        }

        #ui-panel .hud-clock {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 2px;
            color: #00ffcc;
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.6);
        }

        #ui-panel #log-container {
            height: 148px;
            overflow-y: auto;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.7rem;
            line-height: 1.55;
            color: #72f2eb;
            padding: 8px 10px;
            border: 1px solid rgba(0, 255, 204, 0.14);
            border-radius: 3px;
            background-color: rgba(0, 10, 15, 0.62);
            background-image: repeating-linear-gradient(0deg, rgba(0, 255, 204, 0.04) 0 1px, transparent 1px 3px);
        }

        #ui-panel #log-container div {
            border-left: 2px solid rgba(0, 255, 204, 0.35);
            padding-left: 8px;
            margin-bottom: 5px;
            word-break: break-word;
        }

        #ui-panel #log-container div:first-child { border-left-color: #00ffcc; }

        #ui-panel #log-container div { animation: logIn 0.3s ease; }
        #ui-panel #log-container div.sys { color: #72f2eb; }
        #ui-panel #log-container div.skill { color: #ffd479; }
        #ui-panel #log-container div.agent { color: #3dff9e; }
        #ui-panel #log-container div.err { color: #ff6b81; border-left-color: #ff4d6d; }

        @@keyframes logIn {
            from { opacity: 0; transform: translateX(-6px); }
        }

        #ui-panel #log-container::-webkit-scrollbar { width: 6px; }
        #ui-panel #log-container::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.04); }
        #ui-panel #log-container::-webkit-scrollbar-thumb {
            background: rgba(0, 255, 204, 0.45);
            border-radius: 3px;
        }

        /* ── Responsivo ───────────────────────────────────── */
        @@media (max-width: 520px) {
            #ui-panel {
                left: 12px;
                right: 12px;
                top: 12px;
                width: auto;
                padding: 16px;
            }

            #ui-panel .telemetry { grid-template-columns: repeat(2, 1fr); }
            #hud-fx .frame { inset: 6px; }
        }
    </style>
}

