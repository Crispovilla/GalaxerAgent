@{
    ViewData["Title"] = "Halcón Milenario · Agente";
    ViewData["HideNav"] = true;
    /* Evita que el navegador sirva HTML/JS de constelación en caché */
    Context.Response.Headers["Cache-Control"] = "no-store, no-cache, must-revalidate";
}

@section styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Rajdhani:wght@400;500;600&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        #canvas-container {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            display: block;
            z-index: 1;
            background: radial-gradient(ellipse at center, #071026 0%, #03060f 70%);
        }

        /* ── Efectos HUD de fondo ─────────────────────────── */
        #hud-fx {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 2;
            overflow: hidden;
        }

        #hud-fx .vignette {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center, transparent 42%, rgba(2, 6, 18, 0.72) 100%);
        }

        #hud-fx .scan {
            position: absolute;
            left: 0;
            right: 0;
            height: 160px;
            background: linear-gradient(to bottom, transparent, rgba(0, 255, 204, 0.07) 50%, transparent);
            animation: hudScan 9s linear infinite;
        }

        #hud-fx .frame {
            position: absolute;
            inset: 14px;
            border: 1px solid rgba(0, 255, 204, 0.12);
        }

        #hud-fx .frame::before,
        #hud-fx .frame::after {
            content: "";
            position: absolute;
            width: 26px;
            height: 26px;
            border: solid rgba(0, 255, 204, 0.55);
        }

        #hud-fx .frame::before {
            top: -1px;
            left: -1px;
            border-width: 2px 0 0 2px;
        }

        #hud-fx .frame::after {
            bottom: -1px;
            right: -1px;
            border-width: 0 2px 2px 0;
        }

        /* Efecto hiperespacio (se activa mientras la nave viaja) */
        #hud-fx .streaks {
            position: absolute;
            inset: -50%;
            background: repeating-conic-gradient(from 0deg at 50% 50%, transparent 0deg 5deg, rgba(170, 220, 255, 0.12) 5deg 5.5deg);
            -webkit-mask-image: radial-gradient(circle, transparent 16%, black 70%);
            mask-image: radial-gradient(circle, transparent 16%, black 70%);
            opacity: 0;
            transition: opacity 0.7s ease;
        }

        #hud-fx.warp .streaks {
            opacity: 1;
            animation: warpSpin 16s linear infinite;
        }

        #hud-fx.warp .scan {
            animation-duration: 4.5s;
        }

        @@keyframes warpSpin {
            to { transform: rotate(360deg); }
        }

        @@keyframes hudScan {
            0% { top: -18%; opacity: 0; }
            12% { opacity: 1; }
            88% { opacity: 1; }
            100% { top: 118%; opacity: 0; }
        }

        @@keyframes hudPulse {
            50% { opacity: 0.3; }
        }

        @@keyframes hudSheen {
            0% { left: -80%; }
            55%, 100% { left: 135%; }
        }

        @@keyframes hudBlink {
            50% { opacity: 0.2; }
        }

        /* ── Parabrisas del cockpit (esquinas superiores) ── */
        #hud-fx .strut {
            position: absolute;
            top: 0;
            height: 48%;
            width: 30%;
            background: linear-gradient(165deg, rgba(3, 8, 17, 0.92), rgba(3, 8, 17, 0.55) 55%, rgba(3, 8, 17, 0));
            pointer-events: none;
        }

        #hud-fx .strut.l { left: 0; clip-path: polygon(0 0, 100% 0, 0 100%); }
        #hud-fx .strut.r { right: 0; clip-path: polygon(0 0, 100% 0, 100% 100%); }

        /* ── Computadora de navegación (arriba derecha) ─── */
        #hud-waypoint {
            position: fixed;
            top: 26px;
            right: 26px;
            z-index: 10;
            min-width: 214px;
            box-sizing: border-box;
            padding: 12px 14px;
            font-family: 'Share Tech Mono', monospace;
            color: #d7e7ff;
            background: linear-gradient(160deg, rgba(8, 14, 28, 0.88), rgba(4, 8, 18, 0.92));
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 232, 31, 0.35);
            border-radius: 5px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 25px rgba(255, 232, 31, 0.08);
            opacity: 0;
            transform: translateY(-14px);
            transition: opacity 0.4s ease, transform 0.4s ease;
            pointer-events: none;
        }

        #hud-waypoint.show { opacity: 1; transform: translateY(0); }

        #hud-waypoint .wp-k {
            font-size: 0.56rem;
            letter-spacing: 2.5px;
            color: #b99b3a;
            text-transform: uppercase;
        }

        #hud-waypoint .wp-k::before { content: "\25B8 "; color: #ffe81f; }

        #hud-waypoint #wp-name {
            margin-top: 5px;
            font-size: 0.86rem;
            color: #ffe81f;
            text-shadow: 0 0 10px rgba(255, 232, 31, 0.5);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 250px;
        }

        #hud-waypoint .wp-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 7px;
            font-size: 0.72rem;
            color: #9fd8ff;
        }

        #hud-waypoint #wp-arrow {
            width: 18px;
            height: 18px;
            transition: transform 0.2s linear;
        }

        #hud-waypoint #wp-arrow polygon {
            fill: #00ffcc;
            filter: drop-shadow(0 0 4px #00ffcc);
        }

        #hud-waypoint #wp-dist { color: #00ffcc; }

        /* ── FX de lanzamiento ─────────────────────────── */
        #launch-fx {
            position: fixed;
            inset: 0;
            z-index: 30;
            pointer-events: none;
            opacity: 0;
            background: radial-gradient(circle at 50% 62%, rgba(210, 250, 255, 0.95), rgba(0, 190, 255, 0.4) 32%, transparent 72%);
        }

        body.launching #launch-fx { animation: launchFlash 1.35s ease-out forwards; }

        @@keyframes launchFlash {
            0% { opacity: 0; transform: scale(0.55); }
            12% { opacity: 1; }
            100% { opacity: 0; transform: scale(1.7); }
        }

        /* ── Panel inferior: dashboard del cockpit ──────── */
        #dash {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            height: 106px;
            z-index: 4;
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 26px;
            padding: 14px 30px 8px;
            background: linear-gradient(to top, rgba(2, 6, 14, 0.95), rgba(2, 6, 14, 0.78) 55%, rgba(2, 6, 14, 0));
            clip-path: polygon(0 26px, 7% 4px, 93% 4px, 100% 26px, 100% 100%, 0 100%);
            font-family: 'Share Tech Mono', monospace;
            color: #9fd8ff;
        }

        #dash .dash-mod {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        #dash .mod-k {
            font-size: 0.52rem;
            letter-spacing: 2px;
            color: #5f7a99;
            text-transform: uppercase;
        }

        #dash #radar {
            width: 78px;
            height: 78px;
            display: block;
        }

        #dash #speedo {
            width: 132px;
            display: block;
        }

        #dash .pwr-bars {
            display: flex;
            gap: 5px;
        }

        #dash .pwr-bars i {
            width: 14px;
            height: 26px;
            border-radius: 2px;
            border: 1px solid rgba(255, 179, 71, 0.4);
            background: rgba(255, 179, 71, 0.08);
            transition: background 0.25s, box-shadow 0.25s;
        }

        #dash .pwr-bars i.on {
            background: #ffb347;
            box-shadow: 0 0 10px rgba(255, 179, 71, 0.7);
        }

        #dash .nav-mod {
            margin-left: auto;
            text-align: right;
        }

        #dash .nav-line {
            font-size: 0.74rem;
            color: #72f2eb;
            letter-spacing: 1px;
            margin-top: 3px;
        }

        #dash .nav-line b {
            color: #ffe81f;
            font-weight: normal;
        }

        @@media (max-width: 760px) {
            #dash .radar-mod, #dash .nav-mod { display: none; }
        }

        /* ── Panel principal ──────────────────────────────── */
        .hud-panel {
            position: absolute;
            top: 26px;
            left: 26px;
            width: 384px;
            box-sizing: border-box;
            padding: 22px 22px 18px;
            z-index: 10;
            color: #d7e7ff;
            font-family: 'Rajdhani', 'Segoe UI', sans-serif;
            background: linear-gradient(160deg, rgba(8, 14, 28, 0.9), rgba(4, 8, 18, 0.94));
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(0, 255, 204, 0.28);
            border-radius: 5px;
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.55), 0 0 35px rgba(0, 255, 204, 0.08), inset 0 0 60px rgba(0, 255, 204, 0.035);
        }

        .hud-panel::before,
        .hud-panel::after,
        .hud-panel .brackets::before,
        .hud-panel .brackets::after {
            content: "";
            position: absolute;
            width: 22px;
            height: 22px;
            border: solid #00ffcc;
            pointer-events: none;
        }

        .hud-panel::before { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
        .hud-panel::after { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }
        .hud-panel .brackets::before { top: -1px; right: -1px; border-width: 2px 2px 0 0; border-color: rgba(0, 136, 255, 0.9); }
        .hud-panel .brackets::after { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; border-color: rgba(0, 136, 255, 0.9); }

        /* ── Encabezado ───────────────────────────────────── */
        .hud-panel .panel-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            padding-bottom: 14px;
            margin-bottom: 16px;
            border-bottom: 1px solid rgba(0, 255, 204, 0.16);
            position: relative;
        }

        .hud-panel .panel-head::after {
            content: "";
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 72px;
            height: 1px;
            background: #00ffcc;
            box-shadow: 0 0 10px #00ffcc;
        }

        .hud-panel h3 {
            margin: 0;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            background: linear-gradient(90deg, #ffe81f, #ffb347 42%, #00ffcc 82%, #0088ff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 8px rgba(255, 200, 40, 0.35));
        }

        .hud-panel .head-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .hud-panel .ship-icon {
            width: 34px;
            height: 34px;
            color: #00ffcc;
            filter: drop-shadow(0 0 6px rgba(0, 255, 204, 0.6));
            flex-shrink: 0;
        }

        .hud-panel .subtitle {
            margin-top: 5px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.62rem;
            letter-spacing: 3px;
            color: #5f7a99;
            text-transform: uppercase;
        }

        .hud-panel .status {
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.62rem;
            letter-spacing: 1.5px;
            color: #8affe8;
            white-space: nowrap;
            padding-top: 4px;
        }

        .hud-panel .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ffcc00;
            color: #ffcc00;
            box-shadow: 0 0 9px currentColor;
            animation: hudPulse 1.6s ease-in-out infinite;
        }

        .hud-panel .dot.online { background: #00ff9d; color: #00ff9d; }
        .hud-panel .dot.linking { background: #ffcc00; color: #ffcc00; }
        .hud-panel .dot.offline { background: #ff3b6b; color: #ff3b6b; }

        /* ── Campos ───────────────────────────────────────── */
        .hud-panel .field { margin-bottom: 14px; }

        .hud-panel label {
            display: block;
            margin-bottom: 6px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.66rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #6fe3ff;
        }

        .hud-panel label::before {
            content: "\25B8 ";
            color: #00ffcc;
        }

        .hud-panel input,
        .hud-panel textarea {
            width: 100%;
            box-sizing: border-box;
            background: rgba(0, 255, 255, 0.04);
            border: 1px solid rgba(120, 180, 255, 0.18);
            border-left: 2px solid rgba(0, 255, 204, 0.55);
            border-radius: 3px;
            color: #e6f6ff;
            padding: 10px 12px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.78rem;
            outline: none;
            transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
        }

        .hud-panel input:focus,
        .hud-panel textarea:focus {
            border-color: rgba(0, 255, 204, 0.7);
            background: rgba(0, 255, 204, 0.07);
            box-shadow: 0 0 0 1px rgba(0, 255, 204, 0.25), 0 0 18px rgba(0, 255, 204, 0.18);
        }

        .hud-panel textarea { resize: vertical; min-height: 64px; }

        /* ── Fila de ruta con explorador ─────────────────── */
        .hud-panel .path-row { display: flex; gap: 0; align-items: stretch; }

        .hud-panel .path-row input {
            flex: 1 1 auto;
            min-width: 0;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .hud-panel .btn-browse {
            flex: 0 0 auto;
            padding: 0 15px;
            border: 1px solid rgba(120, 180, 255, 0.18);
            border-left: none;
            border-right: 2px solid rgba(0, 255, 204, 0.55);
            border-radius: 0 3px 3px 0;
            background: rgba(0, 255, 204, 0.07);
            color: #00ffcc;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.2s, box-shadow 0.2s;
        }

        .hud-panel .btn-browse:hover {
            background: rgba(0, 255, 204, 0.18);
            box-shadow: 0 0 14px rgba(0, 255, 204, 0.3);
        }

        /* ── Modal explorador de rutas ───────────────────── */
        #path-explorer {
            position: fixed;
            inset: 0;
            z-index: 60;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(2, 6, 18, 0.35);
        }

        #path-explorer.open { display: flex; }

        #path-explorer .pe-box {
            width: min(660px, 94vw);
            max-height: 78vh;
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(0, 255, 204, 0.35);
            border-radius: 6px;
            background: linear-gradient(180deg, rgba(6, 18, 34, 0.98), rgba(3, 8, 16, 0.98));
            box-shadow: 0 0 44px rgba(0, 255, 204, 0.18);
            font-family: 'Share Tech Mono', monospace;
        }

        #path-explorer .pe-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px;
            border-bottom: 1px solid rgba(0, 255, 204, 0.2);
            color: #00ffcc;
            font-size: 0.74rem;
            letter-spacing: 2.5px;
            text-transform: uppercase;
        }

        #path-explorer .pe-head button {
            border: none;
            background: none;
            color: #6fe3ff;
            font-size: 1.15rem;
            line-height: 1;
            cursor: pointer;
            padding: 0 4px;
        }

        #path-explorer .pe-head button:hover { color: #ff3b6b; }

        #path-explorer .pe-hint {
            color: #6fe3ff;
            font-size: 0.62rem;
            letter-spacing: 1px;
            text-transform: none;
            opacity: 0.75;
            margin-left: auto;
            margin-right: 12px;
        }

        @@media (max-width: 720px) {
            #path-explorer .pe-hint { display: none; }
        }

        #path-explorer .pe-crumb {
            padding: 9px 14px;
            border-bottom: 1px solid rgba(120, 180, 255, 0.14);
            background: rgba(0, 255, 255, 0.04);
            color: #8affe8;
            font-size: 0.74rem;
            word-break: break-all;
            min-height: 20px;
        }

        #path-explorer .pe-list {
            flex: 1 1 auto;
            overflow-y: auto;
            padding: 6px;
            min-height: 180px;
            max-height: 46vh;
        }

        #path-explorer .pe-item {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
            padding: 9px 10px;
            border: 1px solid transparent;
            border-radius: 3px;
            background: none;
            color: #dff4ff;
            font-family: inherit;
            font-size: 0.78rem;
            text-align: left;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s;
        }

        #path-explorer .pe-item:hover {
            background: rgba(0, 255, 204, 0.09);
            border-color: rgba(0, 255, 204, 0.35);
        }

        #path-explorer .pe-item svg { flex: 0 0 auto; color: #ffcc00; }

        #path-explorer .pe-item.pe-up { color: #6fe3ff; }
        #path-explorer .pe-item.pe-up svg { color: #6fe3ff; }

        #path-explorer .pe-empty,
        #path-explorer .pe-msg {
            padding: 14px 10px;
            color: #7f93a8;
            font-size: 0.74rem;
            text-align: center;
        }

        #path-explorer .pe-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 11px 14px;
            border-top: 1px solid rgba(0, 255, 204, 0.2);
        }

        #path-explorer .pe-foot #pe-msg {
            color: #ff8fa3;
            font-size: 0.7rem;
            word-break: break-all;
        }

        #path-explorer .pe-actions { display: flex; gap: 8px; flex-shrink: 0; }

        #path-explorer .pe-actions button {
            padding: 9px 14px;
            border-radius: 3px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.7rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: box-shadow 0.2s, background 0.2s;
        }

        #path-explorer #pe-cancel {
            border: 1px solid rgba(120, 180, 255, 0.3);
            background: transparent;
            color: #6fe3ff;
        }

        #path-explorer #pe-cancel:hover { background: rgba(120, 180, 255, 0.12); }

        #path-explorer #pe-select {
            border: none;
            background: linear-gradient(135deg, #00ffcc, #00a2ff);
            color: #021018;
            font-weight: 700;
        }

        #path-explorer #pe-select:hover { box-shadow: 0 0 18px rgba(0, 255, 204, 0.5); }

        #path-explorer #pe-select:disabled {
            opacity: 0.35;
            cursor: not-allowed;
            box-shadow: none;
        }

        /* ── Botón ────────────────────────────────────────── */
        .hud-panel .btn-start {
            position: relative;
            overflow: hidden;
            width: 100%;
            margin-top: 2px;
            padding: 13px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #021018;
            background: linear-gradient(135deg, #00ffcc, #00a2ff);
            box-shadow: 0 0 18px rgba(0, 255, 204, 0.35), inset 0 0 12px rgba(255, 255, 255, 0.25);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .hud-panel .btn-start:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 32px rgba(0, 255, 204, 0.6), 0 8px 22px rgba(0, 0, 0, 0.45);
        }

        .hud-panel .btn-start:active { transform: translateY(0) scale(0.985); }

        .hud-panel .btn-start::after {
            content: "";
            position: absolute;
            top: 0;
            left: -80%;
            width: 45%;
            height: 100%;
            background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.55), transparent);
            transform: skewX(-20deg);
            animation: hudSheen 3.4s ease-in-out infinite;
        }

        /* ── Barra de misión ─────────────────────────────── */
        .hud-panel .mission-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 12px;
            padding: 9px 11px;
            border: 1px solid rgba(0, 136, 255, 0.35);
            border-left: 2px solid #0088ff;
            border-radius: 3px;
            background: rgba(0, 60, 120, 0.16);
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 1px;
            min-height: 20px;
        }

        .hud-panel .mission-bar .mission-label {
            color: #0088ff;
            text-transform: uppercase;
            letter-spacing: 2px;
            flex-shrink: 0;
        }

        .hud-panel .mission-bar .mission-label::before {
            content: "\25C6 ";
            color: #00ffcc;
        }

        .hud-panel .mission-status {
            color: #9fd8ff;
            word-break: break-word;
        }

        .hud-panel .mission-status.working { color: #00ffcc; text-shadow: 0 0 8px rgba(0, 255, 204, 0.5); }
        .hud-panel .mission-status.done { color: #3dff9e; text-shadow: 0 0 8px rgba(61, 255, 158, 0.6); }
        .hud-panel .mission-status.error { color: #ff4d6d; text-shadow: 0 0 8px rgba(255, 77, 109, 0.6); }

        .hud-panel .mission-bar.is-working {
            border-color: rgba(0, 255, 204, 0.5);
            background-image: repeating-linear-gradient(115deg, rgba(0, 255, 204, 0.10) 0 10px, transparent 10px 20px);
            animation: missionSlide 1s linear infinite;
        }

        @@keyframes missionSlide {
            to { background-position: -20px 0; }
        }

        /* ── Telemetría del halcón ────────────────────────── */
        .hud-panel .telemetry {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin-top: 12px;
        }

        .hud-panel .tel {
            border: 1px solid rgba(255, 179, 71, 0.25);
            background: rgba(60, 34, 0, 0.18);
            border-radius: 3px;
            padding: 6px 4px;
            text-align: center;
            font-family: 'Share Tech Mono', monospace;
            min-width: 0;
        }

        .hud-panel .tel .tel-k {
            display: block;
            font-size: 0.5rem;
            letter-spacing: 1.5px;
            color: #b98a4a;
            text-transform: uppercase;
        }

        .hud-panel .tel .tel-v {
            display: block;
            margin-top: 3px;
            font-size: 0.72rem;
            color: #ffb347;
            text-shadow: 0 0 8px rgba(255, 179, 71, 0.45);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .hud-panel .tel .tel-v.on {
            color: #3dff9e;
            text-shadow: 0 0 8px rgba(61, 255, 158, 0.6);
        }

        /* ── Log ──────────────────────────────────────────── */
        .hud-panel .log-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 17px;
            margin-bottom: 6px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.62rem;
            letter-spacing: 2.5px;
            color: #5f7a99;
            text-transform: uppercase;
        }

        .hud-panel .log-head .live::before {
            content: "\25CF";
            color: #ff3b6b;
            margin-right: 6px;
            animation: hudBlink 1.3s ease-in-out infinite;
        }

        .hud-panel .hud-clock {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 2px;
            color: #00ffcc;
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.6);
        }

        .hud-panel .log-container {
            height: 148px;
            overflow-y: auto;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.7rem;
            line-height: 1.55;
            color: #72f2eb;
            padding: 8px 10px;
            border: 1px solid rgba(0, 255, 204, 0.14);
            border-radius: 3px;
            background-color: rgba(0, 10, 15, 0.62);
            background-image: repeating-linear-gradient(0deg, rgba(0, 255, 204, 0.04) 0 1px, transparent 1px 3px);
        }

        .hud-panel .log-container div {
            border-left: 2px solid rgba(0, 255, 204, 0.35);
            padding-left: 8px;
            margin-bottom: 5px;
            word-break: break-word;
        }

        .hud-panel .log-container div:first-child { border-left-color: #00ffcc; }

        .hud-panel .log-container div { animation: logIn 0.3s ease; }
        .hud-panel .log-container div.sys { color: #72f2eb; }
        .hud-panel .log-container div.skill { color: #ffd479; }
        .hud-panel .log-container div.agent { color: #3dff9e; }
        .hud-panel .log-container div.err { color: #ff6b81; border-left-color: #ff4d6d; }

        @@keyframes logIn {
            from { opacity: 0; transform: translateX(-6px); }
        }

        .hud-panel .log-container::-webkit-scrollbar { width: 6px; }
        .hud-panel .log-container::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.04); }
        .hud-panel .log-container::-webkit-scrollbar-thumb {
            background: rgba(0, 255, 204, 0.45);
            border-radius: 3px;
        }

        /* ── Botón central: nuevo agente ──────────────────── */
        #btn-new-agent {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 30;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 20px;
            border-radius: 999px;
            cursor: pointer;
            border: 1px solid rgba(0, 255, 204, 0.55);
            background: linear-gradient(135deg, rgba(0, 255, 204, 0.16), rgba(0, 136, 255, 0.16));
            color: #9be7ff;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.66rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            box-shadow: 0 0 18px rgba(0, 255, 204, 0.25);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            transition: box-shadow 0.2s, transform 0.2s;
        }

        #btn-new-agent .plus {
            font-size: 1.15rem;
            line-height: 1;
            color: #00ffcc;
            text-shadow: 0 0 10px rgba(0, 255, 204, 0.8);
        }

        #btn-new-agent:hover {
            transform: translateX(-50%) translateY(-2px);
            box-shadow: 0 0 32px rgba(0, 255, 204, 0.55);
        }

        /* ── Control de vista (bajo el botón +) ───────────── */
        #view-control {
            position: fixed;
            top: 70px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 29;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 13px;
            border-radius: 5px;
            border: 1px solid rgba(255, 232, 31, 0.32);
            background: linear-gradient(160deg, rgba(8, 14, 28, 0.9), rgba(4, 8, 18, 0.93));
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 12px 34px rgba(0, 0, 0, 0.45);
            font-family: 'Share Tech Mono', monospace;
        }

        #view-control .vc-title {
            font-size: 0.56rem;
            letter-spacing: 2px;
            color: #b99b3a;
            text-transform: uppercase;
            white-space: nowrap;
        }

        #view-control .vc-title::before { content: "\25B8 "; color: #ffe81f; }

        #view-list {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: center;
            max-width: 64vw;
        }

        #view-control .vc-item {
            border: 1px solid rgba(120, 180, 255, 0.25);
            background: rgba(0, 60, 120, 0.15);
            color: #9fd8ff;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.64rem;
            letter-spacing: 1px;
            padding: 5px 10px;
            border-radius: 3px;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
            white-space: nowrap;
        }

        #view-control .vc-item:hover {
            background: rgba(0, 255, 204, 0.12);
            border-color: rgba(0, 255, 204, 0.5);
        }

        #view-control .vc-item.active {
            border-color: #ffe81f;
            color: #ffe81f;
            background: rgba(90, 76, 0, 0.25);
            box-shadow: 0 0 12px rgba(255, 232, 31, 0.35);
        }

        #view-control .vc-sep {
            width: 1px;
            align-self: stretch;
            background: rgba(255, 255, 255, 0.16);
        }

        /* ── Selector de interfaz gráfica (skin) ─────────────── */
        #skin-control {
            position: fixed;
            top: 70px;
            right: 26px;
            z-index: 30;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 13px;
            border-radius: 5px;
            border: 1px solid rgba(204, 119, 255, 0.34);
            background: linear-gradient(160deg, rgba(14, 8, 28, 0.9), rgba(8, 4, 18, 0.93));
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 12px 34px rgba(0, 0, 0, 0.45);
            font-family: 'Share Tech Mono', monospace;
        }

        #skin-control .sk-title {
            font-size: 0.56rem;
            letter-spacing: 2px;
            color: #b58ad6;
            text-transform: uppercase;
            white-space: nowrap;
        }

        #skin-control .sk-title::before { content: "\25B8 "; color: #cc77ff; }

        #skin-list {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: center;
        }

        #skin-control .sk-item {
            border: 1px solid rgba(204, 119, 255, 0.28);
            background: rgba(70, 0, 120, 0.16);
            color: #e0b8ff;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.64rem;
            letter-spacing: 1px;
            padding: 5px 11px;
            border-radius: 3px;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
            white-space: nowrap;
        }

        #skin-control .sk-item:hover {
            background: rgba(204, 119, 255, 0.14);
            border-color: rgba(204, 119, 255, 0.6);
        }

        #skin-control .sk-item.active {
            border-color: #cc77ff;
            color: #f4e6ff;
            background: rgba(88, 20, 130, 0.32);
            box-shadow: 0 0 12px rgba(204, 119, 255, 0.4);
        }

        /* ── Contenedor de la skin "Cerebro" (misma caja que la galaxia) ── */
        #brain-container {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            display: none;
            z-index: 1;
            background: radial-gradient(ellipse at center, #0a0620 0%, #03040f 72%);
        }

        /* ── Modal de estructura (diagrama de carpetas) ──────── */
        body.sm-modal-open { overflow: hidden; }

        #structure-modal {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #structure-modal.sm-hidden { display: none; }

        #structure-modal .sm-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(2, 5, 14, 0.82);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
        }

        #structure-modal .sm-panel {
            position: relative;
            width: min(1080px, 94vw);
            height: min(720px, 90vh);
            display: flex;
            flex-direction: column;
            border-radius: 8px;
            border: 1px solid rgba(0, 255, 204, 0.34);
            background: linear-gradient(160deg, rgba(6, 12, 26, 0.97), rgba(3, 6, 14, 0.985));
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.6), 0 0 40px rgba(0, 255, 204, 0.08);
            overflow: hidden;
            font-family: 'Share Tech Mono', monospace;
        }

        #structure-modal .sm-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 16px;
            border-bottom: 1px solid rgba(0, 255, 204, 0.2);
            background: rgba(0, 20, 40, 0.5);
        }

        #structure-modal .sm-title-wrap { display: flex; align-items: center; gap: 11px; min-width: 0; }

        #structure-modal .sm-glyph { color: #00ffcc; font-size: 1.15rem; filter: drop-shadow(0 0 6px rgba(0, 255, 204, 0.7)); }

        #structure-modal .sm-title {
            color: #7ef7e2;
            font-size: 0.82rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        #structure-modal .sm-path {
            color: #6f8ba3;
            font-size: 0.68rem;
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 560px;
        }

        #structure-modal .sm-tools { display: flex; gap: 6px; flex-shrink: 0; }

        #structure-modal .sm-btn {
            border: 1px solid rgba(0, 255, 204, 0.28);
            background: rgba(0, 60, 90, 0.22);
            color: #8fe6ff;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.66rem;
            letter-spacing: 1px;
            padding: 5px 10px;
            border-radius: 3px;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
        }

        #structure-modal .sm-btn:hover { background: rgba(0, 255, 204, 0.14); border-color: rgba(0, 255, 204, 0.6); color: #d6fff7; }

        #structure-modal .sm-btn-icon { padding: 5px 9px; font-size: 0.8rem; line-height: 1; }

        #structure-modal .sm-close { border-color: rgba(255, 90, 90, 0.4); color: #ff8a8a; }
        #structure-modal .sm-close:hover { background: rgba(255, 90, 90, 0.16); border-color: #ff5a5a; color: #ffd0d0; }

        #structure-modal .sm-body { position: relative; flex: 1; min-height: 0; overflow: hidden; }

        #structure-modal .sm-loading {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #7ea3bb;
            font-size: 0.8rem;
            letter-spacing: 1px;
            z-index: 2;
        }

        #structure-modal .sm-loading.sm-hidden { display: none; }

        #structure-modal .sm-empty {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #5c778c;
            font-size: 0.78rem;
            z-index: 2;
        }

        #structure-modal .sm-empty.sm-hidden { display: none; }

        #structure-modal #sm-svg {
            width: 100%;
            height: 100%;
            display: block;
            cursor: grab;
            background:
                radial-gradient(circle at 20% 15%, rgba(0, 90, 140, 0.12), transparent 45%),
                radial-gradient(circle at 85% 85%, rgba(0, 255, 204, 0.05), transparent 50%),
                repeating-linear-gradient(0deg, transparent 0 39px, rgba(60, 120, 160, 0.06) 39px 40px),
                repeating-linear-gradient(90deg, transparent 0 39px, rgba(60, 120, 160, 0.06) 39px 40px);
        }

        #structure-modal #sm-svg.sm-panning { cursor: grabbing; }

        #structure-modal .sm-node rect {
            fill: rgba(8, 24, 44, 0.92);
            stroke: rgba(0, 200, 255, 0.4);
            stroke-width: 1.1;
            transition: stroke 0.15s, fill 0.15s;
        }

        #structure-modal .sm-node:hover rect { fill: rgba(0, 70, 110, 0.6); stroke: #00ffcc; }

        #structure-modal .sm-node.sm-root rect {
            fill: rgba(10, 60, 60, 0.85);
            stroke: #00ffcc;
            stroke-width: 1.6;
            filter: url(#sm-glow);
        }

        #structure-modal .sm-node.sm-collapsed rect { stroke-dasharray: 4 3; }

        #structure-modal .sm-label {
            fill: #cfe9f7;
            font-family: 'Share Tech Mono', monospace;
            font-size: 12.5px;
            pointer-events: none;
            user-select: none;
        }

        #structure-modal .sm-root .sm-label { fill: #7ef7e2; font-size: 13px; }

        #structure-modal .sm-badge {
            fill: #ffb347;
            font-family: 'Share Tech Mono', monospace;
            font-size: 9.5px;
            pointer-events: none;
            user-select: none;
            opacity: 0.9;
        }

        #structure-modal .sm-toggle circle {
            fill: rgba(4, 16, 30, 0.95);
            stroke: #00ffcc;
            stroke-width: 1.3;
        }

        #structure-modal .sm-toggle text {
            fill: #00ffcc;
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px;
            font-weight: bold;
            pointer-events: none;
            user-select: none;
        }

        #structure-modal .sm-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 16px;
            border-top: 1px solid rgba(0, 255, 204, 0.16);
            background: rgba(0, 16, 32, 0.5);
            color: #6f8ba3;
            font-size: 0.64rem;
            letter-spacing: 1px;
        }

        #structure-modal .sm-hint { color: #4d6a80; }

        /* ── Ventanas laterales (agentes en paralelo) ─────── */
        #side-windows {
            position: fixed;
            top: 26px;
            left: 26px;
            bottom: 150px;
            width: 384px;
            z-index: 12;
            display: flex;
            flex-direction: column;
            gap: 14px;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 2px;
            pointer-events: none;
        }

        #side-windows .agent-window {
            position: relative;
            top: 0;
            left: 0;
            pointer-events: auto;
            flex: 0 0 auto;
            margin: 0;
        }

        #side-windows::-webkit-scrollbar { width: 6px; }
        #side-windows::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.04); }
        #side-windows::-webkit-scrollbar-thumb {
            background: rgba(0, 255, 204, 0.45);
            border-radius: 3px;
        }

        .agent-window { width: 100%; box-sizing: border-box; }
        .agent-window.hidden,
        #ui-panel.hidden { display: none; }

        /* ── Acordeón: una ventana expandida a la vez ───── */
        .agent-window .panel-head { cursor: pointer; user-select: none; }

        .agent-window.collapsed { padding-bottom: 16px; }
        .agent-window.collapsed .subtitle,
        .agent-window.collapsed .win-extra { display: none; }
        .agent-window.collapsed .field { margin-bottom: 9px; }
        .agent-window.collapsed .panel-head {
            margin-bottom: 13px;
            padding-bottom: 10px;
        }

        .agent-window:not(.collapsed) { animation: winExpand 0.16s ease; }

        @@keyframes winExpand {
            from { opacity: 0.5; transform: translateY(-5px); }
            to { opacity: 1; transform: none; }
        }

        .hud-panel .head-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .hud-panel .win-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            padding-top: 4px;
        }

        .hud-panel .win-min,
        .hud-panel .win-toggle,
        .hud-panel .win-close {
            width: 27px;
            height: 27px;
            border: 1px solid rgba(120, 180, 255, 0.3);
            background: rgba(0, 255, 204, 0.06);
            color: #6fe3ff;
            border-radius: 3px;
            cursor: pointer;
            font-size: 1rem;
            line-height: 1;
            transition: background 0.15s, color 0.15s, box-shadow 0.15s;
        }

        .hud-panel .win-min:hover,
        .hud-panel .win-toggle:hover {
            background: rgba(0, 255, 204, 0.18);
            color: #00ffcc;
            box-shadow: 0 0 12px rgba(0, 255, 204, 0.35);
        }

        .hud-panel .win-close {
            color: #ff8fa3;
            border-color: rgba(255, 107, 129, 0.35);
            background: rgba(255, 77, 109, 0.07);
        }

        .hud-panel .win-close:hover {
            background: rgba(255, 77, 109, 0.22);
            color: #ff4d6d;
            box-shadow: 0 0 12px rgba(255, 77, 109, 0.45);
        }

        /* ── Barra inferior de agentes (resumen) ──────────── */
        #agents-bar {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 106px;
            z-index: 13;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 26px;
            pointer-events: none;
            background: linear-gradient(to top, rgba(2, 6, 14, 0.92), rgba(2, 6, 14, 0.5) 70%, transparent);
            overflow-x: auto;
            overflow-y: hidden;
        }

        #agents-bar.hidden { display: none; }

        .agent-chip {
            pointer-events: auto;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 7px 12px;
            border-radius: 4px;
            cursor: pointer;
            border: 1px solid rgba(0, 255, 204, 0.25);
            background: linear-gradient(160deg, rgba(8, 14, 28, 0.92), rgba(4, 8, 18, 0.94));
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.66rem;
            color: #9fd8ff;
            max-width: 360px;
            white-space: nowrap;
            transition: box-shadow 0.15s, border-color 0.15s, transform 0.15s;
        }

        .agent-chip:hover {
            box-shadow: 0 0 16px rgba(0, 255, 204, 0.35);
            transform: translateY(-1px);
        }

        .agent-chip .chip-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #5f7a99;
            box-shadow: 0 0 8px currentColor;
            flex-shrink: 0;
            animation: hudPulse 1.6s ease-in-out infinite;
        }

        .agent-chip.st-working .chip-dot { background: #ffcc00; color: #ffcc00; }
        .agent-chip.st-done .chip-dot { background: #3dff9e; color: #3dff9e; }
        .agent-chip.st-error .chip-dot { background: #ff3b6b; color: #ff3b6b; }

        .agent-chip .chip-name {
            color: #00ffcc;
            letter-spacing: 1px;
            text-transform: uppercase;
            flex-shrink: 0;
        }

        .agent-chip .chip-mission {
            color: #7f93a8;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 210px;
        }

        .agent-chip.minimized {
            border-color: rgba(255, 232, 31, 0.45);
            box-shadow: 0 0 10px rgba(255, 232, 31, 0.18);
        }

        .agent-chip.minimized .chip-mission { color: #b99b3a; }

        /* ── Responsivo ───────────────────────────────────── */
        @@media (max-width: 520px) {
            .hud-panel {
                left: 12px;
                right: 12px;
                top: 12px;
                width: auto;
                padding: 16px;
            }

            .hud-panel .telemetry { grid-template-columns: repeat(2, 1fr); }
            #hud-fx .frame { inset: 6px; }
        }

        /* ── Skin Cerebro: tablero neural (reemplaza al del Halcón) ── */
        #dash-brain {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            height: 106px;
            z-index: 4;
            pointer-events: none;
            display: none;
            align-items: center;
            gap: 34px;
            padding: 14px 30px 8px;
            background: linear-gradient(to top, rgba(9, 4, 20, 0.95), rgba(9, 4, 20, 0.78) 55%, rgba(9, 4, 20, 0));
            clip-path: polygon(0 26px, 7% 4px, 93% 4px, 100% 26px, 100% 100%, 0 100%);
            font-family: 'Share Tech Mono', monospace;
            color: #cbb6ff;
        }

        #dash-brain .dash-mod {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
        }

        #dash-brain .mod-k {
            font-size: 0.52rem;
            letter-spacing: 2px;
            color: #8a76b8;
            text-transform: uppercase;
        }

        #dash-brain .brain-stats {
            align-items: flex-start;
            gap: 3px;
            min-width: 168px;
        }

        #dash-brain .neuro-stat {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            width: 100%;
            font-size: 0.63rem;
            letter-spacing: 1px;
        }

        #dash-brain .neuro-stat span { color: #8a76b8; }
        #dash-brain .neuro-stat b {
            color: #e9dcff;
            font-weight: 600;
            text-shadow: 0 0 9px rgba(180, 140, 255, 0.55);
        }

        /* Alterna tableros y acentos según la skin activa */
        [data-skin="cerebro"] #dash { display: none; }
        [data-skin="cerebro"] #dash-brain { display: flex; }
        [data-skin="cerebro"] .hud-panel .ship-icon { color: #c39dff; }
        [data-skin="cerebro"] .hud-panel h3 {
            color: #e6d8ff;
            text-shadow: 0 0 12px rgba(170, 130, 255, 0.6);
        }
        [data-skin="cerebro"] .hud-panel .subtitle { color: #9b86d6; }
        [data-skin="cerebro"] .hud-panel .mission-label { color: #b79cff; }
        [data-skin="cerebro"] .hud-panel .tel-k { color: #8a76b8; }
