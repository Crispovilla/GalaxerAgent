            background: linear-gradient(135deg, #6a34d6, #9a4dff);
            border-color: rgba(190, 150, 255, 0.6);
            box-shadow: 0 0 20px rgba(150, 90, 255, 0.4);
            color: #f3edff;
        }
    </style>
}

