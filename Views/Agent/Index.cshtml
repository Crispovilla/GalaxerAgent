@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/GammaCorrectionShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/FXAAShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="~/js/structure-modal.js" asp-append-version="true"></script>
    <script src="~/js/constellation.js" asp-append-version="true"></script>
    <script src="~/js/skins/brain-scene.js" asp-append-version="true"></script>
    <script src="~/js/skins/skin-manager.js" asp-append-version="true"></script>
    <script src="~/js/skins/skin-theme.js" asp-append-version="true"></script>
    <script>
        (function () {
            var clock = document.getElementById('hud-clock');
            var dot = document.getElementById('status-dot');
            var label = document.getElementById('status-label');
            var states = {
                Connected: ['online', 'LINKED'],
                Connecting: ['linking', 'LINKING'],
                Reconnecting: ['linking', 'RETRY'],
                Disconnecting: ['linking', 'CLOSING'],
                Disconnected: ['offline', 'OFFLINE']
            };

            function tick() {
                if (clock) {
                    clock.textContent = new Date().toLocaleTimeString('es-CL', { hour12: false });
                }
                try {
                    var state = (typeof connection !== 'undefined' && connection) ? connection.state : 'Disconnected';
                    var info = states[state] || states.Disconnected;
                    dot.className = 'dot ' + info[0];
                    label.textContent = info[1];
                } catch (e) { }
            }

            tick();
            setInterval(tick, 1000);
        })();
    </script>
    <script>
        (function () {
            var modal = document.getElementById('path-explorer');
            var listEl = document.getElementById('pe-list');
            var crumbEl = document.getElementById('pe-crumb');
            var msgEl = document.getElementById('pe-msg');
            var btnSelect = document.getElementById('pe-select');
            var btnBrowse = document.getElementById('btnBrowse');
            var input = document.getElementById('targetPath');
            if (!modal || !input) return;

            var current = '';
            var explorerInput = input;
            var folderIcon = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6.5a1.5 1.5 0 0 1 1.5-1.5h4l2 2.5h8A1.5 1.5 0 0 1 20 9v8.5a1.5 1.5 0 0 1-1.5 1.5h-14A1.5 1.5 0 0 1 3 17.5z"/></svg>';
            var upIcon = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 19V6M6 12l6-6 6 6"/></svg>';

            function escapeHtml(value) {
                return String(value).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            function openModal(targetInput) {
                explorerInput = targetInput || input;
                modal.classList.add('open');
                modal.setAttribute('aria-hidden', 'false');
                load(explorerInput.value.trim());
            }

            window.openPathExplorer = openModal;

            function closeModal() {
                modal.classList.remove('open');
                modal.setAttribute('aria-hidden', 'true');
            }

            function renderItem(icon, label, onClick) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'pe-item';
                btn.innerHTML = icon + '<span>' + escapeHtml(label) + '</span>';
                btn.addEventListener('click', onClick);
                listEl.appendChild(btn);
                return btn;
            }

            async function load(path) {
                listEl.innerHTML = '';
                msgEl.textContent = '';
                crumbEl.textContent = 'Unidades';
                btnSelect.disabled = true;

                try {
                    var res = await fetch('/api/agent/browse?path=' + encodeURIComponent(path || ''));
                    var data = await res.json();
                    if (!res.ok) {
                        msgEl.textContent = data.message || 'Error al leer la ruta.';
                        return;
                    }

                    current = data.path || '';
                    crumbEl.textContent = current || 'Unidades (raíz del equipo)';
                    btnSelect.disabled = !current;

                    if (data.error) msgEl.textContent = data.error;

                    /* Desplegar la carpeta actual como bases espaciales en la escena
                       (clave atada a la ventana que abrió el explorador) */
                    try {
                        if (typeof renderFolderBases === 'function') {
                            renderFolderBases(current, (data.folders || []).map(f => f.path), window.__explorerPreviewKey || 'default');
                        }
                    } catch (e) { }

                    if (data.parent) {
                        var up = renderItem(upIcon, '..  Volver arriba', function () { load(data.parent); });
                        up.classList.add('pe-up');
                    }

                    (data.folders || []).forEach(function (folder) {
                        renderItem(folderIcon, folder.name, function () { load(folder.path); });
                    });

                    if (!data.parent && (!data.folders || !data.folders.length)) {
                        var empty = document.createElement('div');
                        empty.className = 'pe-empty';
                        empty.textContent = 'Sin subcarpetas';
                        listEl.appendChild(empty);
                    }
                } catch (err) {
                    msgEl.textContent = 'Error de conexión: ' + err;
                }
            }

            if (btnBrowse) {
                btnBrowse.addEventListener('click', function () { openModal(input); });
            }
            document.getElementById('pe-close').addEventListener('click', closeModal);
            document.getElementById('pe-cancel').addEventListener('click', closeModal);

            btnSelect.addEventListener('click', function () {
                if (!current) return;
                if (explorerInput) explorerInput.value = current;
                closeModal();
                try {
                    if (typeof focusFolderBase === 'function') focusFolderBase(current);
                } catch (e) { }
            });

            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
            });
        })();
    </script>
}
